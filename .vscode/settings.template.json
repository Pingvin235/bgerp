{
    "files.exclude": {
        ".classpath": true,
        ".gradle": true,
        ".project": true,
        ".settings": true,
        "bin": true,
        "gradle": true,
        "lfs": true,
        "target": true,
        "tmp": true
    },
    // Gradle task 'vscode' relies on Windows path here in settings.template.json
    "java.jdt.ls.java.home": "C:\\Java\\jdk25",
    "java.configuration.updateBuildConfiguration": "automatic",
    "java.format.settings.url": ".vscode/formatter.xml",
    "files.trimTrailingWhitespace": true,
    "editor.renderWhitespace": "all",
    "editor.fontSize": 11,
    "terminal.integrated.fontSize": 11,
    "debug.console.fontSize": 11,
    "cSpell.words": [
        "bgcrm",
        "bgerp",
        "combocheck",
        "listcount",
        "pers",
        "servlet",
        "strikethrough",
        "warnd"
    ]
}